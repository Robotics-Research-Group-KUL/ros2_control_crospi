{
    "blackboard": {
        "etasl": {
            "general": {
                "event_topic": "crospi_node/events",
                "sample_time": 0.01
            },
            "initializer": {
                "full": true,
                "sample_time": 0.01,
                "duration": 3.0,
                "convergence_criterion": 1e-08,
                "weightfactor": 10000.0
            },
            "solver": {
                "is-qpoasessolver": true,
                "nWSR": 100,
                "regularization_factor": 1e-08,
                "cputime": 10
            }
        },
        "robot": {
            "robotdrivers": [
                {
                    "is-ros2_control_crospi": true,
                    "robot_joints": [
                        "shoulder_pan_joint",
                        "shoulder_lift_joint",
                        "elbow_joint",
                        "wrist_1_joint",
                        "wrist_2_joint",
                        "wrist_3_joint"
                    ],
                    "periodicity": 0.01,
                    "robot_description_path": "$[ur_description]/urdf/ur_mocked.urdf.xacro",
                    "xacro_arguments": {
                        "name": "ur",
                        "ur_type": "ur10e",
                        "initial_positions_file": "$[ros2_control_crospi]/config/ur10e_initial_positions.yaml"
                    },
                    "command_interface": "velocity",
                    "hardware_components": [
                        "ur"
                    ],
                    "initialization_timeout": 5.0,
                    "ros_node_name": "ros2_control_crospi_driver",
                    "force_torque_sensor_name": "tcp_fts_sensor",
                    "name_expr_joint_vel": "joint_vel",
                    "name_expr_cartesian_wrench": "wrench_input"
                }
            ],
            "robotsimulators": [
                {
                    "is-ros2_control_crospi": true,
                    "robot_joints": [
                        "shoulder_pan_joint",
                        "shoulder_lift_joint",
                        "elbow_joint",
                        "wrist_1_joint",
                        "wrist_2_joint",
                        "wrist_3_joint"
                    ],
                    "periodicity": 0.01,
                    "robot_description_path": "$[ur_description]/urdf/ur_mocked.urdf.xacro",
                    "xacro_arguments": {
                        "name": "ur",
                        "ur_type": "ur10e",
                        "initial_positions_file": "$[ros2_control_crospi]/config/ur10e_initial_positions.yaml"
                    },
                    "command_interface": "velocity",
                    "hardware_components": [
                        "ur"
                    ],
                    "initialization_timeout": 5.0,
                    "ros_node_name": "ros2_control_crospi_simulator",
                    "force_torque_sensor_name": "tcp_fts_sensor",
                    "name_expr_joint_vel": "joint_vel",
                    "name_expr_cartesian_wrench": "wrench_input"
                }
            ],
            "default_robot_specification": {
                "is-inline_robotspecification": true,
                "urdf_path": "$[crospi_application_template]/robot_models/urdf_models/robot_setups/ur10e/ur10e_cylinder_tool.urdf",
                "tcp_frame": {
                    "child_link": "tool0",
                    "parent_link": "base_link"
                },
                "additional_frames": [
                    {
                        "name": "FT_sensor_frame",
                        "child_link": "tool0",
                        "parent_link": "base_link"
                    }
                ],
                "robot_joints": [
                    "shoulder_pan_joint",
                    "shoulder_lift_joint",
                    "elbow_joint",
                    "wrist_1_joint",
                    "wrist_2_joint",
                    "wrist_3_joint"
                ]
            }
        },
        "iohandlers": {
            "outputhandlers": [
                {
                    "is-JointStateOutputHandler": true,
                    "topic-name": "/joint_states"
                },
                {
                    "is-TopicOutputHandler": true,
                    "topic-name": "/forces_etasl",
                    "variable-names": [
                        "x_force",
                        "y_force",
                        "z_force",
                        "x_torque",
                        "y_torque",
                        "z_torque"
                    ]
                }
            ],
            "inputhandlers": []
        }
    },
    "$defs": {}
}